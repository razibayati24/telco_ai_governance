# =============================================================================
# AI Governance Monitor - Configuration
# =============================================================================
# Copy this file to .env and fill in your workspace-specific values.
# These values are also set in app.yaml for Databricks Apps deployment.
# =============================================================================

# --- Required ---

# Your Unity Catalog name (e.g., "my_catalog")
DATABRICKS_CATALOG=

# SQL Warehouse ID (found in SQL Warehouses > your warehouse > Connection Details)
DATABRICKS_WAREHOUSE_ID=

# Foundation model serving endpoint name for LLM chat features
# (e.g., "databricks-claude-sonnet-4", "databricks-meta-llama-3-3-70b-instruct")
DATABRICKS_LLM_ENDPOINT=databricks-claude-sonnet-4

# Vector Search endpoint name (for Policy Assistant RAG)
DATABRICKS_VS_ENDPOINT=

# --- Optional ---

# Schema name (defaults to "ai_governance")
DATABRICKS_SCHEMA=ai_governance

# Vector Search index name (defaults to <catalog>.<schema>.policy_chunks_vs_index)
# DATABRICKS_VS_INDEX=

# Genie Space ID (created by notebook 03, leave blank to skip Genie embed)
# DATABRICKS_GENIE_SPACE_ID=

# Databricks CLI profile for local development (defaults to "DEFAULT")
# DATABRICKS_PROFILE=
