# =============================================================================
# AI Governance Monitor - Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in your workspace-specific values, then
# either source it before running locally:
#     set -a && source .env && set +a
# or feed it into `bootstrap.py` / `render-app-yaml.py` to render `app.yaml`.
#
# Layered config:
#   1. This file (.env)        — workspace-specific resource IDs / env vars
#   2. template.config.json    — UI copy, brand strings, demo questions
#   3. app.yaml                — generated from app.yaml.template + this .env
# =============================================================================

# -----------------------------------------------------------------------------
# Workspace authentication (local development only — Databricks Apps inject
# credentials automatically at runtime)
# -----------------------------------------------------------------------------

# Databricks workspace host (https://...cloud.databricks.com)
DATABRICKS_HOST=

# Databricks CLI profile (used for local dev only). Default: DEFAULT
DATABRICKS_PROFILE=DEFAULT

# -----------------------------------------------------------------------------
# Required: Unity Catalog & Warehouse
# -----------------------------------------------------------------------------

# Unity Catalog name where the m_*/v_* governance tables and policy KB live.
# Example: "main", "my_company_catalog"
DATABRICKS_CATALOG=

# Schema within the catalog. Default: ai_governance
DATABRICKS_SCHEMA=ai_governance

# SQL Warehouse ID powering the dashboard queries.
# Find it in: SQL Warehouses > <your warehouse> > Connection Details > Warehouse ID
DATABRICKS_WAREHOUSE_ID=

# -----------------------------------------------------------------------------
# Required: AI / LLM endpoints
# -----------------------------------------------------------------------------

# Foundation model serving endpoint name used by the Policy Assistant and
# Genie Q&A chat panels. Examples:
#   databricks-claude-sonnet-4-5
#   databricks-claude-sonnet-4
#   databricks-meta-llama-3-3-70b-instruct
DATABRICKS_LLM_ENDPOINT=databricks-claude-sonnet-4-5

# Vector Search endpoint used to host the policy_chunks_vs_index.
# Create in: Compute > Vector Search > Create Endpoint (Standard tier).
DATABRICKS_VS_ENDPOINT=

# Embedding model endpoint used by the Vector Search Delta Sync index.
# Default: databricks-gte-large-en
DATABRICKS_EMBEDDING_MODEL=databricks-gte-large-en

# -----------------------------------------------------------------------------
# Optional: Vector Search index override
# -----------------------------------------------------------------------------

# Full 3-part index name. If empty, defaults to:
#   ${DATABRICKS_CATALOG}.${DATABRICKS_SCHEMA}.policy_chunks_vs_index
# DATABRICKS_VS_INDEX=

# -----------------------------------------------------------------------------
# Optional: Genie integration
# -----------------------------------------------------------------------------

# Genie Space ID (notebook 03 prints this after creating the space).
# Leave empty to skip the Genie Q&A panel — the LLM-powered Genie chat will
# still work without a Genie Room since it goes through the LLM directly.
DATABRICKS_GENIE_SPACE_ID=

# Optional purpose-specific Genie spaces consumed by the Multi-Agent
# Supervisor (Chat tab).  These are *informational* — the supervisor itself
# owns Genie routing — but they show up in /api/agent/config so a deployer
# can wire them into their own MAS definition.
DATABRICKS_FINOPS_GENIE_SPACE_ID=
DATABRICKS_AI_OPS_GENIE_SPACE_ID=

# -----------------------------------------------------------------------------
# Optional: Multi-Agent Supervisor (Agent Bricks) endpoint for the Chat tab
# -----------------------------------------------------------------------------
#
# When set, /api/agent/ask forwards chat threads to this serving endpoint
# (an Agent Bricks Multi-Agent Supervisor that orchestrates a FinOps
# Explorer over Genie + a Contract Analyst over a Knowledge Assistant).
# Leave blank to use the Foundation-Model + Genie SQL fallback — the chat
# tab still works, it just doesn't route through the supervisor.
#
# Set up via: Mosaic AI > Agents > Multi-Agent Supervisor.  Once created,
# the endpoint name has the form `mas-<hash>-endpoint`.
DATABRICKS_MAS_ENDPOINT=

# -----------------------------------------------------------------------------
# Branding / display copy (overrides values in template.config.json)
# -----------------------------------------------------------------------------

# Customer / brand the deployed app represents (shown in header, page title,
# RAG system prompt, policy KB defaults). Examples:
#   "Acme Corp", "MT&T", "Northwind Bank"
BRAND_NAME=Acme Corp

# Holding company / parent (optional — used for "Built for {parent}" copy)
BRAND_PARENT=Acme Holdings

# Industry vertical (drives default sample copy for prompts/policies).
# Examples: "Telco", "Retail", "Finance", "Healthcare", "Manufacturing"
BRAND_INDUSTRY=Generic

# Email domain used in masking UDFs / sample audit data. Example: "acme.com"
EMAIL_DOMAIN=example.com

# Application title shown in the browser tab and page header.
# Default: "AI Governance & Observability"
APP_TITLE=AI Governance & Observability

# Application subtitle (small grey text under the title).
# Default: "AI Agentic FinOps Assistant"
APP_SUBTITLE=AI Agentic FinOps Assistant

# -----------------------------------------------------------------------------
# Optional: Databricks App identity (used by bootstrap.py + deploy scripts)
# -----------------------------------------------------------------------------

# The Databricks App name (must be globally unique within your workspace).
DATABRICKS_APP_NAME=ai-governance-monitor

# Workspace path where source code is synced for deployment.
# Example: /Workspace/Users/you@example.com/databricks_apps/ai-governance-monitor
DATABRICKS_APP_SOURCE_PATH=

# -----------------------------------------------------------------------------
# Optional: Super-user account group for dynamic column masking
# -----------------------------------------------------------------------------
#
# Members of this account-level group see *unmasked* values in m_* tables
# (email, IP, free-text columns).  All other viewers see masked values
# resolved by mask UDFs created by `notebooks/05_setup_super_user_masking.py`.
#
# The group must already exist in the Account Console (Settings > Identity >
# Groups) and be added to your workspace.  Notebook 05 will create the UDFs
# and apply column masks parameterized by this name + your catalog/schema.
#
# Default name pattern: <brand_lowercase>_ai_gov_super_users
SUPER_USER_GROUP_NAME=ai_gov_super_users
